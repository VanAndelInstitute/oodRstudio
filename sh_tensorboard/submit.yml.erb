<%
    raw = sh_partition.to_s.strip
    partition = "dev"
    nodelist = nil

    unless raw.empty?
        p, n = raw.split(":", 2).map { |x| x.to_s.strip }

        if n.nil? || n.empty?
            partition = p unless p.empty?
        else
            partition = p unless p.empty?
            nodelist = n
        end
    end
%>

batch_connect:
  template: "basic"

script:
  job_name: tensorboard_ondemand
  native: [
            "-c", "<%= sh_cpus.blank?  ? 1 : sh_cpus.to_i %>",
            <%- if not sh_gpus.blank? -%>
                "-G", "<%= sh_gpus.to_i %>",
            <%- end -%>
            <%- if not sh_mem.blank? -%>
                "--mem", "<%= sh_mem.to_i %>G",
            <%- end -%>
            <%- if nodelist.present? -%>
                "-w", "<%= nodelist %>"
            <%- end -%>
          ]
  queue_name: <%= partition %>

